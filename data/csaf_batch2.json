me\":{\"name\":\"Version 4.26.6 with Hotfix SecurityAdvisory87_Hotfix.swix 1.0\",\"product_id\":\"CSAFPID-97\"},\"product_reference\":\"CSAFPID-32\",\"relates_to_product_reference\":\"CSAFPID-68\"},{\"category\":\"installed_with\",\"full_product_name\":{\"name\":\"Version 4.29.0.1 with Hotfix SecurityAdvisory87_Hotfix.swix 1.0\",\"product_id\":\"CSAFPID-130\"},\"product_reference\":\"CSAFPID-65\",\"relates_to_product_reference\":\"CSAFPID-68\"},{\"category\":\"installed_with\",\"full_product_name\":{\"name\":\"Version 4.25.3.2 with Hotfix SecurityAdvisory87_Hotfix.swix 1.0\",\"product_id\":\"CSAFPID-76\"},\"product_reference\":\"CSAFPID-12\",\"relates_to_product_reference\":\"CSAFPID-68\"}]},\"vulnerabilities\":[{\"cve\":\"CVE-2023-24510\",\"id\":{\"system_name\":\"Arista Bug ID\",\"text\":\"753188\"},\"notes\":[{\"category\":\"description\",\"text\":\"On the affected platforms running EOS, a malformed DHCP packet might cause the DHCP relay agent to restart.\",\"title\":\"CVE Description\"},{\"category\":\"other\",\"text\":\"The crash can happen only if there are multiple helper addresses.\\nOne or multiple helper address must be with source-interface or cross-vrf\\nThe other helper addresses must be in same-vrf without source-interface config\\n\\nSample config with source-interface:\\ninterface Vlan100\\n   ip helper-address 10.93.188.2 source-interface Loopback2\\n   ip helper-address 10.93.188.3 source-interface Loopback2\\n   ip address 10.93.160.1/22\\n!\\n\\nSample config with cross-vrf:\\ninterface Vlan100\\n   vrf BLUE\\n   ip helper-address 10.93.188.2 vrf RED\\n   ip helper-address 10.93.188.3 vrf RED\\n   ip address 10.93.160.1/22\\n!\",\"title\":\"753188: Required Config for Exploitation\"}],\"product_status\":{\"first_affected\":[\"CSAFPID-2\"],\"first_fixed\":[\"CSAFPID-100\",\"CSAFPID-101\",\"CSAFPID-102\",\"CSAFPID-103\",\"CSAFPID-104\",\"CSAFPID-105\",\"CSAFPID-106\",\"CSAFPID-107\",\"CSAFPID-108\",\"CSAFPID-109\",\"CSAFPID-110\",\"CSAFPID-111\",\"