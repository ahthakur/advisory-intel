red Config for Exploitation\"}],\"product_status\":{\"first_affected\":[\"CSAFPID-2\"],\"fixed\":[\"CSAFPID-0\",\"CSAFPID-1\",\"CSAFPID-3\",\"CSAFPID-4\",\"CSAFPID-5\"]},\"references\":[{\"category\":\"external\",\"summary\":\"MITRE\",\"url\":\"https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2024-12378\"}],\"remediations\":[{\"category\":\"vendor_fix\",\"details\":\"Fixed in EOS version 4.29.10\",\"product_ids\":[\"CSAFPID-1\"]},{\"category\":\"vendor_fix\",\"details\":\"Fixed in EOS version 4.30.9\",\"product_ids\":[\"CSAFPID-0\"]},{\"category\":\"vendor_fix\",\"details\":\"Fixed in EOS version 4.31.7\",\"product_ids\":[\"CSAFPID-5\"]},{\"category\":\"vendor_fix\",\"details\":\"Fixed in EOS version 4.32.3\",\"product_ids\":[\"CSAFPID-4\"]},{\"category\":\"vendor_fix\",\"details\":\"Fixed in EOS version 4.33.0\",\"product_ids\":[\"CSAFPID-3\"]},{\"category\":\"none_available\",\"details\":\"Not fixed in EOS version 4.27.1\",\"product_ids\":[\"CSAFPID-2\"]},{\"category\":\"mitigation\",\"details\":\"The workaround is to remove and re-apply security profiles for each secure VTEP.\\n\\nswitch> show vxlan security profile\\nVTEP          Security Profile\\n------------- ----------------\\n1.0.2.1                     p1\\nswitch> en\\nswitch# config\\nswitch(config)# interface vxlan 1\\nswitch(config-if-Vx1)# no vxlan vtep 1.0.2.1 ip security profile p1\\nswitch(config-if-Vx1)# vxlan vtep 1.0.2.1 ip security profile p1\"}],\"scores\":[{\"cvss_v3\":{\"baseScore\":9.1,\"baseSeverity\":\"CRITICAL\",\"vectorString\":\"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N\",\"version\":\"3.1\"},\"products\":[\"CSAFPID-63\",\"CSAFPID-64\",\"CSAFPID-69\",\"CSAFPID-66\",\"CSAFPID-109\",\"CSAFPID-102\",\"CSAFPID-26\",\"CSAFPID-39\",\"CSAFPID-40\",\"CSAFPID-94\",\"CSAFPID-65\",\"CSAFPID-24\",\"CSAFPID-46\",\"CSAFPID-53\",\"CSAFPID-89\",\"CSAFPID-48\",\"CSAFPID-14\",\"CSAFPID-90\",\"CSAFPID-38\",\"CSAFPID-60\",\"CSAFPID-47\",\"CSAFPID-29\",\"CSAFPID-106\",\"CSAFPID-13\",\"CSAFPID-58\",\"